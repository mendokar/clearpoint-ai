# Copia este archivo a .env.local y rellena los valores. NUNCA subas .env.local al repositorio.
# Todo lo que empieza por NEXT_PUBLIC_ llega al navegador: ahí solo van valores públicos por diseño.

# ── Públicas (llegan al navegador) ─────────────────────────────────────────────
# Firebase Console → Configuración del proyecto → Tus apps → App web.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Stripe Dashboard (modo test) → Developers → API keys → Publishable key (pk_test_...).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# URL pública del agente (Cloud Run), sin barra final. Ej.: https://agent-xxxx.europe-southwest1.run.app
NEXT_PUBLIC_AGENT_URL=
# URL pública de esta web, sin barra final. Ej.: https://<app>.vercel.app (en local: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=

# ── Secretas (solo servidor) ───────────────────────────────────────────────────
# JSON de la cuenta de servicio de Firebase Admin codificado en base64:
#   base64 -w0 service-account.json
FIREBASE_ADMIN_CREDENTIALS=
# Stripe (modo test): sk_test_... y el whsec_... del endpoint de webhook (o de `stripe listen`).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Email de confirmación por Gmail (SMTP). Requiere verificación en dos pasos en la cuenta y una
# contraseña de aplicación: https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Nombre visible del remitente (opcional, por defecto "Colchones Contoso").
EMAIL_FROM_NAME=
# Destinatario del aviso "Nuevo pedido" a la tienda (opcional; si falta, se usa GMAIL_USER).
ADMIN_NOTIFICATION_EMAIL=

# ── Pasos manuales en Firebase Console (inicio de sesión con Google) ───────────
# 1. Authentication → Sign-in method → habilitar "Correo electrónico/contraseña" y "Google"
#    (elige el email de asistencia del proyecto).
# 2. Authentication → Settings → Authorized domains → añadir el dominio de Vercel
#    (<app>.vercel.app y el dominio propio si lo hay). localhost ya viene autorizado.
