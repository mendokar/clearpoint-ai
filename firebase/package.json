{
  "name": "contoso-firebase",
  "private": true,
  "type": "module",
  "scripts": {
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-contoso \"vitest run\"",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes,storage",
    "deploy:storage": "firebase deploy --only storage"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "4.0.1",
    "firebase": "11.10.0",
    "firebase-tools": "14.11.0",
    "vitest": "3.2.4"
  }
}
