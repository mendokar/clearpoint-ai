# Copia este fichero a .env para desarrollo local. NO pongas valores reales en .env.example.

# --- LLM ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Esfuerzo de razonamiento del modelo de Anthropic: low | medium | high (vacío = por defecto del modelo)
ANTHROPIC_EFFORT=low
# Opcional: si está vacío, el agente funciona sin fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# true = el primario falla siempre para demostrar el fallback (requiere OPENAI_API_KEY)
FORCE_FALLBACK=false

# --- Datos y auth ---
# firestore (producción) | memory (local/tests, carga ../data)
REPOSITORY_BACKEND=memory
# DATA_DIR=../data
FIREBASE_PROJECT_ID=

# --- HTTP ---
ALLOWED_ORIGINS=https://<app>.vercel.app,http://localhost:3000
LOG_LEVEL=INFO
