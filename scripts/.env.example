# Copia a scripts/.env y ejecuta con: npx tsx --env-file=.env seed.ts
# Credencial de Firebase Admin (mismo formato que web: JSON de cuenta de servicio en base64).
# Alternativa: GOOGLE_APPLICATION_CREDENTIALS=/ruta/fuera/del/repo/sa.json
FIREBASE_ADMIN_CREDENTIALS=
FIREBASE_PROJECT_ID=
# Usuarios demo (las contraseñas nunca van en el código; mínimo 8 caracteres).
DEMO1_EMAIL=demo1@contoso.example
DEMO1_PASSWORD=
DEMO2_EMAIL=demo2@contoso.example
DEMO2_PASSWORD=
